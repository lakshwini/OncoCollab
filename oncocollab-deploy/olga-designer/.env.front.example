# ============================================================
# olga-designer/.env.front — Configuration Olga Designer / Admin (Vite)
# Copier ce fichier en .env.front et remplir les valeurs
# ⚠️ Comme pour le frontend principal, ces variables VITE_* ne sont prises
# en compte que si l'image olga-designer/olga-admin les intègre au runtime ;
# vérifier auprès de l'équipe si un rebuild de l'image est nécessaire.
# ============================================================

# URL de l'API Olga (olga-api), accessible depuis le navigateur
VITE_BACKEND_URL=http://localhost:9091

# Supabase — doit correspondre à .env.backend
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_supabase_anon_key

# TURN Server WebRTC — doit correspondre à .env / .env.backend
VITE_TURN_URL=turn:127.0.0.1:3478
VITE_TURN_USERNAME=oncocollab
VITE_TURN_PASSWORD=mot_de_passe_turn_a_choisir
