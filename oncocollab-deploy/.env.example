# ============================================================
# .env — Configuration globale OncoCollab
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# Votre IP publique (pour WebRTC TURN server)
# En local : laisser 127.0.0.1
# ⚠️ En production : mettre votre vraie IP publique (obligatoire pour que la visio
# fonctionne entre utilisateurs derrière des NAT/firewalls différents).
# Le firewall/routeur doit aussi rediriger : 3478/tcp, 3478/udp, 50000-50100/udp.
EXTERNAL_IP=127.0.0.1

# Identifiants du TURN server (choisir librement)
# ⚠️ Doivent être identiques à TURN_URL/TURN_USERNAME/TURN_PASSWORD dans .env.backend
TURN_USERNAME=oncocollab
TURN_PASSWORD=mot_de_passe_turn_a_choisir

# ⚠️ Votre nom d'utilisateur Docker Hub
# Les images seront téléchargées depuis : DOCKER_REGISTRY/oncocollab-frontend:latest
DOCKER_REGISTRY=votre_username_docker_hub

# ─── Génération de rapports RCP (Whisper + Gemini) ─────────
# Clé API Google Gemini — https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=votre_cle_gemini_api

# Modèle Gemini (gemini-2.5-flash recommandé, gemini-1.5-flash si quota limité)
GEMINI_MODEL=gemini-2.5-flash

# Modèle Whisper (tiny/base/small/medium/large — base recommandé)
WHISPER_MODEL=base

# ─── Module d'imagerie médicale OncoVision (docker-compose) ───────────────
# Toutes ces variables ont des valeurs par défaut dans docker-compose.yml,
# elles ne sont nécessaires ici que pour personnaliser les identifiants.
# IMAGERIE_SQL_ROOT_PASSWORD=imagerie_root_password
# IMAGERIE_SQL_USER=imagerie
# IMAGERIE_SQL_PASSWORD=imagerie_password
# IMAGERIE_SQL_DATABASE=imagerie
# IMAGERIE_MONGO_USER=imagerie
# IMAGERIE_MONGO_PASSWORD=imagerie_password
# IMAGERIE_MONGO_DATABASE=imagerie
# IMAGERIE_S3_USER=imagerie
# IMAGERIE_S3_PASSWORD=imagerie_password
# IMAGERIE_S3_REGION=eu-west-1
# IMAGERIE_SECRET=imagerie_secret
# IMAGERIE_API_URL=http://localhost:8010
